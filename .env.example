# URL publique du site, utilisée pour les métadonnées, le sitemap et robots.txt.
# Facultatif : vaut https://wise-associates.fr si absente.
NEXT_PUBLIC_SITE_URL=https://wise-associates.fr

# ---------- Backoffice (/admin) ----------
# Variables serveur uniquement (jamais de préfixe NEXT_PUBLIC_). Sans les trois premières, la connexion est refusée.

# Adresse de connexion du compte administrateur unique.
ADMIN_EMAIL=
# Empreinte scrypt du mot de passe, générée par : node scripts/hash-password.mjs (12 caractères minimum).
ADMIN_PASSWORD_HASH=
# Secret de signature des sessions, 32 caractères au moins. Le changer déconnecte tout le monde.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Jeton GitHub « fine-grained » limité au dépôt du site, permission Contents : Read and write.
# Obligatoire sur Vercel. En local (npm run dev), s'il est absent, le backoffice écrit dans content/publications.
GITHUB_CONTENT_TOKEN=
# Dépôt et branche où le backoffice enregistre les publications (valeurs par défaut ci-dessous).
GITHUB_REPOSITORY=wise-associates/website
CONTENT_BRANCH=pre-dev
